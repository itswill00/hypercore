#!/system/bin/sh

export PATH="/data/adb/ap/bin:/data/adb/ksu/bin:/data/adb/magisk:/data/data/com.termux/files/usr/bin:/system/bin:/system/xbin:$PATH"

MOD_DIR="/data/adb/modules/hypercore"
USER_NOTE="${1:-}"

DATE_STR=$(date +"%Y-%m-%d_%H-%M-%S" 2>/dev/null)
[ -z "$DATE_STR" ] && DATE_STR=$(date +"%Y%m%d_%H%M%S" 2>/dev/null)

HASH=$(head -c 16 /dev/urandom 2>/dev/null | sha256sum 2>/dev/null | head -c 6)
[ -z "$HASH" ] && HASH="a1b2c3"

BASE_NAME="hypercore_bugreport-${DATE_STR}-${HASH}"
TMP_DIR="/sdcard/HyperCore_Bugreports/.tmp_bugreport"

rm -rf "$TMP_DIR"
mkdir -p "$TMP_DIR"

if [ -n "$USER_NOTE" ]; then
    printf '%s\n' "$USER_NOTE" > "$TMP_DIR/user_note.txt"
else
    echo "(no description provided)" > "$TMP_DIR/user_note.txt"
fi

if [ -f "/sdcard/Android/hypercore.log" ]; then
    cp "/sdcard/Android/hypercore.log" "$TMP_DIR/hypercore.log"
elif [ -f "/data/adb/hypercore/hypercore.log" ]; then
    cp "/data/adb/hypercore/hypercore.log" "$TMP_DIR/hypercore.log"
elif [ -f "$MOD_DIR/hypercore.log" ]; then
    cp "$MOD_DIR/hypercore.log" "$TMP_DIR/hypercore.log"
else
    touch "$TMP_DIR/hypercore.log"
fi

{
    echo "=== Module ==="
    echo "module_id=$(grep '^id=' "$MOD_DIR/module.prop" 2>/dev/null | cut -d= -f2)"
    echo "module_version=$(grep '^version=' "$MOD_DIR/module.prop" 2>/dev/null | cut -d= -f2)"
    echo ""
    echo "=== Device ==="
    echo "model=$(getprop ro.product.model 2>/dev/null)"
    echo "brand=$(getprop ro.product.brand 2>/dev/null)"
    echo "manufacturer=$(getprop ro.product.manufacturer 2>/dev/null)"
    echo "platform=$(getprop ro.board.platform 2>/dev/null)"
    echo "hardware=$(getprop ro.hardware 2>/dev/null)"
    echo "android=$(getprop ro.build.version.release 2>/dev/null)"
    echo "sdk=$(getprop ro.build.version.sdk 2>/dev/null)"
    echo "fingerprint=$(getprop ro.build.fingerprint 2>/dev/null)"
    echo "kernel=$(uname -r 2>/dev/null)"
    echo "uname=$(uname -a 2>/dev/null)"
    echo "selinux=$(getenforce 2>/dev/null)"
    echo "uptime=$(uptime 2>/dev/null)"
    echo "timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
    echo ""
    echo "=== Root Manager ==="
    if [ -d "/data/adb/ksu" ]; then
        echo "root=KernelSU"
        echo "ksu_version=$(cat /data/adb/ksu/version 2>/dev/null || echo unknown)"
    elif [ -d "/data/adb/ap" ]; then
        echo "root=APatch"
    elif command -v magisk >/dev/null 2>&1; then
        echo "root=Magisk"
        echo "magisk_version=$(magisk -v 2>/dev/null)"
    else
        echo "root=unknown"
    fi
} > "$TMP_DIR/device_info.txt"

{
    echo "=== CPU Freq Policy ==="
    grep -s -H '' \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_governor \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq \
        /sys/devices/system/cpu/cpufreq/policy*/cpuinfo_min_freq \
        /sys/devices/system/cpu/cpufreq/policy*/cpuinfo_max_freq \
        /sys/devices/system/cpu/cpufreq/policy*/sugov_ext/* \
        /sys/devices/system/cpu/cpufreq/policy*/schedutil/* 2>/dev/null

    echo ""
    echo "=== GPU (Mali) ==="
    grep -s -H '' \
        /sys/class/devfreq/*mali*/governor \
        /sys/class/devfreq/*mali*/cur_freq \
        /sys/class/devfreq/*mali*/min_freq \
        /sys/class/devfreq/*mali*/max_freq \
        /sys/class/devfreq/*mali*/polling_interval \
        /sys/devices/platform/soc/*mali*/power_policy 2>/dev/null

    echo ""
    echo "=== GED / FPSGO ==="
    grep -s -H '' /sys/module/ged/parameters/* 2>/dev/null | grep -vE 'uevent|debug|trace|panic'
    grep -s -H '' \
        /sys/kernel/fpsgo/common/force_onoff \
        /sys/kernel/fpsgo/fbt/boost_ta \
        /sys/kernel/fpsgo/fbt/ultra_rescue \
        /sys/kernel/fpsgo/fbt/thrm_enable 2>/dev/null

    echo ""
    echo "=== Thermal Zones ==="
    grep -s -H '' \
        /sys/class/thermal/thermal_zone*/type \
        /sys/class/thermal/thermal_zone*/temp \
        /sys/class/thermal/thermal_message/sconfig \
        /sys/class/thermal/thermal_message/sport_mode 2>/dev/null

    echo ""
    echo "=== Battery / Power ==="
    grep -s -H '' \
        /sys/class/power_supply/*/status \
        /sys/class/power_supply/*/capacity \
        /sys/class/power_supply/*/temp \
        /sys/class/power_supply/*/cycle_count \
        /sys/class/power_supply/*/current_now \
        /sys/class/power_supply/*/voltage_now \
        /sys/kernel/helio-dvfsrc/dvfsrc_qos_mode 2>/dev/null

    echo ""
    echo "=== Screen State ==="
    grep -s -H '' \
        /sys/class/leds/lcd-backlight/brightness \
        /sys/class/graphics/fb0/blank \
        /sys/class/drm/card0-DSI-1/dpms 2>/dev/null

    echo ""
    echo "=== Cpuset ==="
    grep -s -H '' \
        /dev/cpuset/foreground/cpus \
        /dev/cpuset/background/cpus \
        /dev/cpuset/system-background/cpus \
        /dev/cpuset/top-app/cpus 2>/dev/null
} > "$TMP_DIR/sysfs_nodes.txt"

{
    echo "=== HyperCore Processes ==="
    ps -A 2>/dev/null | grep -E 'libhypercore' | grep -v grep || \
        ps 2>/dev/null | grep -E 'libhypercore' | grep -v grep

    echo ""
    echo "=== Top 15 CPU Consumers ==="
    ps -A -o pid,ppid,%cpu,%mem,name 2>/dev/null | head -n 16 || \
        ps -o pid,%cpu,%mem,args 2>/dev/null | head -n 16

    echo ""
    echo "=== Foreground Activity ==="
    dumpsys activity top 2>/dev/null | grep -E 'ACTIVITY|mCurrentFocus' | head -n 5 || \
        dumpsys window windows 2>/dev/null | grep -E 'mCurrentFocus|mFocusedApp' | head -n 4
} > "$TMP_DIR/processes.txt"

{
    echo "=== Logcat (last 200 lines — hypercore & kernel) ==="
    logcat -d -t 200 2>/dev/null | grep -E 'hypercore|libhypercore|kernel|W |E ' | tail -n 200 || \
        logcat -d 2>/dev/null | tail -n 200
} > "$TMP_DIR/logcat_tail.txt"

[ -f "/data/adb/hypercore/gamelist.txt" ] && cp "/data/adb/hypercore/gamelist.txt" "$TMP_DIR/gamelist.txt"
[ -z "$(cat "$TMP_DIR/gamelist.txt" 2>/dev/null)" ] && \
    [ -f "$MOD_DIR/gamelist.txt" ] && cp "$MOD_DIR/gamelist.txt" "$TMP_DIR/gamelist.txt"
[ -f "$MOD_DIR/module.prop" ] && cp "$MOD_DIR/module.prop" "$TMP_DIR/module.prop"

{
    echo "HyperCore Bug Report"
    echo "Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
    echo "Files:"
    ls -lh "$TMP_DIR/" 2>/dev/null
} > "$TMP_DIR/manifest.txt"

OUT_FILE=""

if command -v zip >/dev/null 2>&1; then
    mkdir -p "/sdcard/HyperCore_Bugreports"
    ( cd "$TMP_DIR" && zip -r "/sdcard/HyperCore_Bugreports/${BASE_NAME}.zip" ./* >/dev/null 2>&1 )
    [ -f "/sdcard/HyperCore_Bugreports/${BASE_NAME}.zip" ] && OUT_FILE="/sdcard/HyperCore_Bugreports/${BASE_NAME}.zip"
elif command -v busybox >/dev/null 2>&1 && busybox zip --help >/dev/null 2>&1; then
    mkdir -p "/sdcard/HyperCore_Bugreports"
    ( cd "$TMP_DIR" && busybox zip -r "/sdcard/HyperCore_Bugreports/${BASE_NAME}.zip" ./* >/dev/null 2>&1 )
    [ -f "/sdcard/HyperCore_Bugreports/${BASE_NAME}.zip" ] && OUT_FILE="/sdcard/HyperCore_Bugreports/${BASE_NAME}.zip"
fi

if [ -z "$OUT_FILE" ]; then
    mkdir -p "/sdcard/HyperCore_Bugreports"
    ( cd "$TMP_DIR" && tar -czf "/sdcard/HyperCore_Bugreports/${BASE_NAME}.tar.gz" ./* >/dev/null 2>&1 )
    [ -f "/sdcard/HyperCore_Bugreports/${BASE_NAME}.tar.gz" ] && OUT_FILE="/sdcard/HyperCore_Bugreports/${BASE_NAME}.tar.gz"
fi

if [ -n "$OUT_FILE" ]; then
    cp "$OUT_FILE" "/storage/emulated/0/HyperCore_Bugreports/" 2>/dev/null
    am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d "file://$OUT_FILE" >/dev/null 2>&1
    rm -rf "$TMP_DIR"
    echo "$OUT_FILE"
else
    rm -rf "$TMP_DIR"
    echo "ERROR"
fi
