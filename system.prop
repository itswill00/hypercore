# HyperCore System Properties
# Note: Only boot-time props that are safe for Play Integrity are included here.
# Props that could trigger banking app detection (debug.*, persist.sys.smartpower.*,
# persist.sys.joyose.*, persist.sys.wifi.low_latency) have been removed.
# Runtime performance props are applied by the daemon at runtime via sysfs/resetprop
# scoped to Gaming profile only, so they don't persist after module removal.

# Dalvik / Dex2oat compiler threads
dalvik.vm.dex2oat-threads=8
dalvik.vm.image-dex2oat-threads=8
dalvik.vm.boot-dex2oat-threads=8

# SurfaceFlinger buffer count (safe, non-debug, standard AOSP prop)
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# DSI Touch & Gesture Calibration (standard AOSP calibration props)
touch.size.calibration=geometric
touch.pressure.calibration=amplitude

# Wi-Fi supplicant scan interval (standard, not a debug/persist flag)
wifi.supplicant_scan_interval=180
